{
  "name": "playbook-game-archive",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prestart": "npm run sync-review-images",
    "build": "npm run validate-data && npm run generate-data && docusaurus build && npm run search-index",
    "build:ci": "npm run sync-review-images && docusaurus build && npm run search-index",
    "prebuild": "npm run sync-review-images",
    "sync-review-images": "node scripts/sync-review-images.mjs",
    "search-index": "pagefind --site build --glob \"docs/**/*.html\" --root-selector article --exclude-selectors \".hash-link,.table-of-contents\" --force-language zh",
    "generate-data": "node scripts/generate-games-data.mjs",
    "validate-data": "node scripts/validate-games-data.mjs",
    "check:scripts": "node scripts/check-scripts-syntax.mjs",
    "test:regressions": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "verify:fast": "npm run validate-data && npm run generate-data && npm run check:scripts && npm run typecheck && npm run test:regressions",
    "verify": "npm run verify:fast",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "js-yaml": "^4.1.0",
    "pagefind": "^1.6.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2",
    "undici": "^7.30.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.6"
  }
}
